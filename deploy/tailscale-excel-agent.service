[Unit]
Description=Tailscale Excel local agent
After=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/tailscale-excel-agent.env
ExecStart=/bin/sh -lc 'exec "$HOME/bin/tailscale-excel-bridge" agent "$EXCEL_AGENT_BIND"'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
