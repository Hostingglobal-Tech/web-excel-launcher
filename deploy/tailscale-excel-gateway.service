[Unit]
Description=Tailscale Excel Vultr gateway
After=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/tailscale-excel-gateway.env
ExecStart=/bin/sh -lc 'exec "$HOME/bin/tailscale-excel-bridge" gateway "$EXCEL_GATEWAY_BIND" "$EXCEL_AGENT_URL"'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
