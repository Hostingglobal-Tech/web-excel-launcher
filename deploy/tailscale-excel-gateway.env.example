EXCEL_BRIDGE_TOKEN=same-private-random-token
EXCEL_GATEWAY_BIND=100.y.y.y:8878
EXCEL_AGENT_URL=http://100.x.x.x:8788
EXCEL_GATEWAY_PATH_PREFIX=/web-excel
# Public URL used to build /sample.xlsx links for Microsoft Office Web Viewer.
# If omitted, the gateway falls back to the request Host header.
EXCEL_GATEWAY_PUBLIC_URL=https://your-public-gateway.example.com/web-excel
