EXCEL_BRIDGE_TOKEN=set-a-private-random-token
EXCEL_AGENT_BIND=100.x.x.x:8788
OPENAI_MODEL=gpt-5.5
MS_EXCEL_WEB_URL=https://www.microsoft365.com/launch/excel?auth=1
# Office Web Viewer requires a workbook URL reachable by Microsoft servers.
MS_OFFICE_VIEWER_SRC_URL=http://your-public-gateway.example.com:8878/sample.xlsx
# Add OPENAI_API_KEY in the private env file before running the service.
